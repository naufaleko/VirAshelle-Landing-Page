# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudflare R2 Media Storage — URL of the deployed media-uploader Worker.
# Leave empty to fall back to the Supabase Storage bucket "media" (optional, see README).
VITE_R2_WORKER_URL=https://media-upload.your-subdomain.workers.dev
# The worker itself (auth, CORS, public bucket URL) is configured via
# workers/media-uploader/wrangler.toml [vars]:
# SUPABASE_URL, SUPABASE_ANON_KEY, ADMIN_EMAILS, ALLOWED_ORIGINS, PUBLIC_R2_URL.
# Uploads require a logged-in admin session; redeploy with `npx wrangler deploy`.

# QA scripts (scripts/*.mjs, gitignored except visual-qa.mjs). Admin checks are skipped when unset.
# Accounts live in Supabase Auth; set the passwords here, never in a script or migration.
# QA_ADMIN_ID=virashelle
# QA_ADMIN_PASSWORD=
# QA_CLEVEL_PASSWORD=
# QA_JESICA_PASSWORD=
# QA_DIXON_PASSWORD=
