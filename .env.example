# Firebase Client Configuration (Vite)
# Replace these values with your own Firebase project configuration if you want to use your own database.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Firebase Admin SDK Configuration (Server Side / WebAcc / Next.js)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# VirAshelle Finance (WebAcc) app
# URL where the WebAcc accounting app is deployed. Used by the admin portal's
# "Finance" mode to link out to the dashboard, journals, and reports.
# Defaults to http://localhost:3000 for local dev if left unset.
VITE_FINANCE_APP_URL=
